<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The frame-flow device gate opens the real camera from the target process; without the
         declaration the HAL rejects the open (0 frames == silent-scanner bug class). -->
    <uses-permission android:name="android.permission.CAMERA" />
    <application
        android:allowBackup="false"
        android:label="dpay-ffi-gate" />
</manifest>
