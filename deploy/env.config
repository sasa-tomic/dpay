# Tracked, NON-SECRET deploy configuration. This file + secrets/*.sops.json are the sources
# scripts/gen-deploy-env.sh generates deploy/.env from. Never put a secret here — secrets live
# encrypted in secrets/*.sops.json (edit with `sops secrets/<file>.sops.json`, then `just deploy-env`).

# =============================================================================
# Ledger
# =============================================================================

# `ic`     — a real canister on a real IC network (via ic-agent).
# `memory` — in-memory demo ledger, pre-funded demo accounts, no canister needed. Offline-capable;
#            the full offline-sign → submit → "Paid ✓" flow works with just the relay container.
DPAY_LEDGER=ic

# The canister the relay settles on. REQUIRED when DPAY_LEDGER=ic — the relay exits if unset
# rather than come up on a pretend ledger and hand out receipts for payments that never settled.
# Written here by scripts/dfx-deploy-ic.sh after a mainnet deploy.
DPAY_DFX_IDENTITY=dpay

# The network. Pick one:
#   mainnet                     https://icp-api.io
#   dfx replica on this host    http://host.docker.internal:4943      (the pre-mainnet rehearsal)
DPAY_IC_URL=https://icp-api.io

# Root key fetching. true ONLY for a local replica (each replica has its own key; calls fail
# without it), false on mainnet (fetching means trusting whatever key the endpoint hands back —
# that is precisely the check that makes a receipt trustworthy). Leave blank to let the relay
# decide from DPAY_IC_URL (true only for a loopback address). The relay refuses the unsafe
# combination.
DPAY_IC_FETCH_ROOT_KEY=

# POST /faucet MINTS Demo USD (play money). The canister's `mint` is open by design so any caller
# can mint the demo currency. Safe for the demo: DEMO_USD is unbacked play money, not a real asset.
DPAY_ENABLE_FAUCET=true

# Per-transaction cap, minor units (100000 = 1.00). The facade canister enforces its own cap;
# the relay enforces its own cap.
DPAY_PER_TX_CAP=100000

# =============================================================================
# Public edge (Cloudflare Tunnel)
# =============================================================================

# The tunnel + Cloudflare API credentials are SECRETS — they live encrypted in
# secrets/deploy.sops.json and land in the generated deploy/.env. Provision headlessly with
# `just tunnel-provision` (needs CF_API_TOKEN + DPAY_PUBLIC_HOSTNAME in the environment —
# see README "Automated"); the token is written to sops, never by hand here.

# Override the pinned cloudflared image only if you need to:
# DPAY_CLOUDFLARED_IMAGE=cloudflare/cloudflared:2026.7.1

# =============================================================================
# Relay runtime knobs (all optional — commented defaults are the relay's built-ins)
# =============================================================================

# Landing page ( / ) + Android APK download ( GET /download/dpay.apk ). The relay reads an APK
# once at startup from DPAY_APK_PATH and serves it from the landing page. Default: /srv/dpay.apk
# — baked into the image by deploy/build.sh from the newest release APK. To serve your own APK
# instead, set this var (and mount the file into the container).
# DPAY_APK_PATH=/srv/dpay.apk

# The origin stamped into Trocador webhook params (derived from the request when unset) — set it
# only if the derived origin is wrong for the tunnel:
# DPAY_PUBLIC_ORIGIN=https://dpay.kalaj.org

# Whether X-Forwarded-For may name the client IP for the Trocador agreement's per-client bounds
# (default false; the tunnel IS the proxy — set true only with that understood):
# DPAY_TRUST_PROXY=true

# Per-call upstream timeouts, ms (default 10000; 0 refused at startup):
# DPAY_SOLANA_TIMEOUT_MS=10000
# DPAY_EVM_TIMEOUT_MS=10000

# Trocador per-client bounds, calls/minute (defaults 6 and 4; 0 refused at startup):
# DPAY_TROCADOR_RATE_PER_MIN=6
# DPAY_TROCADOR_TRADE_PER_MIN=4

# API base overrides. Defaults are the verified live hosts (SideShift
# https://sideshift.ai/api/v2; Trocador https://api.trocador.app; Jupiter the live lite-api
# host) — the offline e2e loop points them at relay-internal stubs. Leave unset in prod:
# DPAY_SIDESHIFT_API_BASE=https://sideshift.ai/api/v2
# DPAY_TROCADOR_API_BASE=https://api.trocador.app
# DPAY_JUPITER_API_BASE=https://lite-api.jup.ag

# TROCADOR_LOG_DIR — where the JSONL compliance records fall when DPAY_TROCADOR_PG_DSN is unset
# (the sops-provided Postgres DSN is the prod home; see scripts/gen-deploy-env.sh). This stack
# mounts NO volume, so the JSONL fallback dies on every redeploy — do not rely on it in prod.
# DPAY_TROCADOR_LOG_DIR=/var/log/dpay

# =============================================================================
# Mt Pelerin off-ramp (R2 step 1, 2026-10-12) — the two credentials are SECRETS
# =============================================================================

# The relay's Mt Pelerin proxy + conversion webhook receiver (GET /api/v1/mtpelerin/quote,
# POST+GET /api/v1/mtpelerin/conversion, POST /api/v1/mtpelerin/webhook). The integration
# key DPAY_MTPELERIN_CTKN and the webhook's signature key DPAY_MTPELERIN_WEBHOOK_SECRET are
# SECRETS: they live in secrets/mtpelerin.sops.json under the same key names (sops, the
# Trocador pattern) — decrypt into deploy/.env by scripts/gen-deploy-env.sh. Both are
# exchanged with hello@mtpelerin.com (the R0 email thread: the CTKN by review, the webhook
# secret when they set the webhook up). Unset → the routes answer 503
# `mtpelerin-unconfigured` naming the variable: that tripwire is the designed state until
# the keys land, never a fault.

# The webhook's OPTIONAL authentication key DPAY_MTPELERIN_WEBHOOK_AUTH_KEY: Mt Pelerin's
# setup exchanges TWO keys, this authKey (their POSTs to us carry it in the
# `Authentication` header) and the signature key above (the HMAC key). Optional: until it
# is exchanged and set here, the HMAC signature alone guards the receiver; once set, a
# delivery without the exact header is refused 401 before the signature check. Lives in
# secrets/mtpelerin.sops.json under the same key name (same thread, same sops pattern).

# API base overrides. Default the venue's documented host; the offline e2e loop points it
# at a relay-internal stub. Leave unset in prod:
# DPAY_MTPELERIN_API_BASE=https://api.mtpelerin.com

# The conversion (order-creation) upstream path. BEST-EFFORT pin — the venue's order API
# is contact-gated, so re-pin this from their technical docs (same thread) BEFORE the
# first real conversion:
# DPAY_MTPELERIN_CONVERSION_PATH=/orders

# Where the append-only records fall (mtpelerin-access.jsonl + mtpelerin-orders.jsonl).
# Same caveat as the Trocador JSONL dir: this stack mounts NO volume — the Postgres arm
# is the follow-up when the webhook setup lands.
# DPAY_MTPELERIN_LOG_DIR=/var/log/dpay

# =============================================================================
# EVM rail (ZCHF-first) — the JSON-RPC upstreams are SECRETS
# =============================================================================

# The relay's EVM JSON-RPC proxy (POST /api/v1/evm/rpc[/chainId]) needs per-chain provider
# endpoints INCLUDING their api keys: DPAY_EVM_RPC_URL is the default chain (Ethereum 1);
# DPAY_EVM_RPC_URL_<CHAINID> configures that chain directly (42161 = Arbitrum One — the ZCHF
# rail; 421614 = Arbitrum Sepolia). Those values are secrets and live in
# secrets/deploy.sops.json under the same key names (pattern DPAY_EVM_RPC_URL*) — sops-decrypted
# into deploy/.env by scripts/gen-deploy-env.sh. Unset → the route answers 503 naming the
# variable. ZCHF catalog rows: Arbitrum One 0xD4dD…5553 · Ethereum 0xB58E…21cB.
# (Dev/test-only catalog env-rows — DPAY_EVM_SEPOLIA_TOKEN, DPAY_EVM_ANVIL_TOKEN — are set by
# the e2e harness per-process, never here.)


# =============================================================================
# Image
# =============================================================================

# Runtime base image. deploy/build.sh picks one matching the build host's glibc and verifies it;
# only set this if you know what you're pairing.
# DPAY_RUNTIME_BASE=ubuntu:24.04
# DPAY_IMAGE=dpay-relay:latest

CF_ACCOUNT_ID=ffbdd200090771d2174995002bf0aa7a
DPAY_PUBLIC_HOSTNAME=dpay.kalaj.org
DPAY_CANISTER_ID=ssqti-wiaaa-aaaab-qhdia-cai
