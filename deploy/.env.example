# Copy to `.env` and edit. docker compose reads it automatically.
# This file is the whole configuration surface: the image itself is environment-free.

# =============================================================================
# Ledger — what the relay settles on
# =============================================================================

# `ic`     — a real canister on a real IC network (via ic-agent).
# `memory` — in-memory demo ledger, pre-funded demo accounts, no canister needed. Offline-capable;
#            the full offline-sign → submit → "Paid ✓" flow works with just the relay container.
DPAY_LEDGER=ic

# The canister the relay settles on. REQUIRED when DPAY_LEDGER=ic: with no canister the relay exits
# rather than come up on a pretend ledger and hand out receipts for payments that never settled.
# `just deploy-ic` writes this for you after deploying/upgrading the canister.
DPAY_CANISTER_ID=

# Deploy-time only (read by `just deploy-ic`, ignored by the relay container): the named dfx/icp
# identity used to deploy or upgrade the canister. THAT IDENTITY BECOMES THE IC-LEVEL CANISTER
# CONTROLLER (upgrade authority), so keep it distinct from any personal identity and keep its PEM in
# cold storage (govern-in-place: no NNS/SNS hand-off — see docs/GOVERNANCE.md). Create one with
# `icp-cli new-identity dpay`.
DPAY_DFX_IDENTITY=

# Runtime secret (the prod faucet): hex Ed25519 seed of the relay's DEDICATED faucet key — NOT the
# dfx identity's key material (dfx identities are secp256k1; the relay's agent signs Ed25519, so
# this can never be the deploy identity's private half). `just deploy-ic` generates it once, arms
# the canister's internal CONTROLLER cell with the key's derived principal via set_controller, and
# writes it here; later deploys REUSE it (never regenerated — that would orphan the armed
# controller). Manual equivalent: `openssl rand -hex 32`, derive the principal with
# `cargo run -p dpay-icp-e2e --bin dev-principal -- <seed>`, then
# `dfx canister call <canister> set_controller '(opt principal "<that>")'` as the deploy identity.
# Set → the relay signs its faucet mint calls and POST /api/v1/faucet works (relay-side cooldown,
# credits the user principal). Unset/mismatched → the relay authenticates as a non-controller:
# read routes work, faucet mint refused with 422 'unauthorized: admin ops require the controller
# principal' (verify anytime: `just faucet-verify`). SECRET — the container env is the right place
# for it, do not commit.
DPAY_CONTROLLER_SEED=

# The network. Pick one:
#   mainnet                     https://icp-api.io
#   dfx replica on this host    http://host.docker.internal:4943      (the pre-mainnet rehearsal)
DPAY_IC_URL=https://icp-api.io

# Root key = the trust root for every reply the relay believes.
#   local replica → true   (each replica has its own key; calls fail without it)
#   mainnet       → false  (fetching means trusting whatever key the endpoint hands back — that is
#                           precisely the check that makes a receipt trustworthy)
# Leave blank to let the relay decide from DPAY_IC_URL (true only for a loopback address). The relay
# refuses to start on the unsafe combination.
DPAY_IC_FETCH_ROOT_KEY=

# Test-helpers builds only (offline e2e image): POST /faucet credits the in-process fake-IC
# gateway. The production (agent-build) faucet is NOT gated by this flag — it needs
# DPAY_CONTROLLER_SEED above and enforces the relay-side cooldown itself. Leave false.
DPAY_ENABLE_FAUCET=false

# The OpenCryptoPay till (POST /api/v1/till + /api/v1/till/void + /v1/lnurlp/*): the merchant
# surface that rings up and clears a charge, and the payer surface that quotes it. Its routes are
# not registered unless this is true, so a relay with it false answers all seven with a bare 404.
# The merchant routes need no credential HERE — a merchant signs each request with their own
# device key, which this relay never holds (crates/dpay-relay/src/app.rs). Flipping it needs no
# rebuild — set it here and `cd deploy && docker compose up -d relay`.
DPAY_ENABLE_TILL=false

# Per-transaction cap, minor units (100000 = $1000.00). In-memory ledger only — on `ic` the canister
# enforces its own cap.
DPAY_PER_TX_CAP=100000

# =============================================================================
# Public edge (Cloudflare Tunnel)
# =============================================================================
#
# The remotely managed tunnel's token. Fill it headlessly with `just tunnel-provision` (needs a
# scoped CF_API_TOKEN + DPAY_PUBLIC_HOSTNAME in the environment — see README "Automated"), or paste
# it from the Cloudflare Zero Trust dashboard. Keep this secret out of git.
# (CF_API_TOKEN is a provisioning-time secret used only by the script and is NEVER stored here.)
CF_TUNNEL_TOKEN=
#
# Override the pinned cloudflared image only if you need to:
# DPAY_CLOUDFLARED_IMAGE=cloudflare/cloudflared:2026.7.1

# =============================================================================
# Image
# =============================================================================

# Runtime base image. deploy/build.sh picks one matching the build host's glibc and verifies it;
# only set this if you know what you're pairing.
# DPAY_RUNTIME_BASE=ubuntu:24.04
# DPAY_IMAGE=dpay-relay:latest

# Landing page ( / ) + Android APK download ( GET /download/dpay.apk ).
# The relay reads an APK once at startup from DPAY_APK_PATH and serves it from the landing page.
# Default: /srv/dpay.apk — baked into the image by deploy/build.sh from the newest release APK
# (app/android/app/build/outputs/apk/release/*.apk). No override needed; to serve your own APK
# instead, mount it over that path (e.g. -v /path/to/dpay.apk:/srv/dpay.apk:ro) or set this var.
# If the file is unset/missing the landing page shows "coming soon" — downloads are disabled.
# DPAY_APK_PATH=/srv/dpay.apk
