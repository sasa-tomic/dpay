# Copy to `.env` and edit. docker compose reads it automatically.

# Public fully-qualified domain name Caddy serves and provisions TLS for.
# Local testing: leave as localhost (Caddy issues a locally-trusted cert via its internal CA).
# Real deploy:   e.g. relay.dpay.example — ports 80/443 must be publicly reachable for ACME.
DPAY_FQDN=localhost

# Upstream the reverse proxy forwards to (the relay service:port on the compose network).
DPAY_RELAY_UPSTREAM=relay:8787

# Per-transaction cap in minor units (cents). 100000 = $1000.00.
DPAY_PER_TX_CAP=100000

# Host ports Caddy publishes. 80/443 for a real deploy; bump if they're taken on your dev box
# (e.g. 8080/8443), but ACME/Let's Encrypt for a real domain requires the standard 80/443.
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443
