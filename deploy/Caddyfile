# Caddy fronts the relay on the public FQDN and terminates TLS. One knob: DPAY_FQDN.
#
#   * Real deploy — set DPAY_FQDN=relay.example.com and Caddy auto-provisions a Let's Encrypt cert
#     (ports 80/443 must be publicly reachable for the ACME challenge).
#   * Local test  — leave DPAY_FQDN=localhost; Caddy issues a locally-trusted cert via its internal
#     CA, so https://localhost works (curl -k, or trust Caddy's root).
#
# DPAY_RELAY_UPSTREAM is the service:port the reverse proxy forwards to (default: the compose
# `relay` service on 8787). Same file, both environments — nothing here is environment-specific.

{$DPAY_FQDN:localhost} {
	encode zstd gzip
	reverse_proxy {$DPAY_RELAY_UPSTREAM:relay:8787}
}
