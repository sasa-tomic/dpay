{
  "name": "dpay-e2e",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Radical e2e harness for dpay: drives the REAL app/App.tsx through a browser (react-native-web) against the REAL relay (FakeLedger or live). Seconds-fast, fully offline in `local` mode.",
  "scripts": {
    "postinstall": "node harness/get-browser.mjs",
    "test": "node run.mjs",
    "test:live": "DPAY_E2E_MODE=live node run.mjs",
    "build": "vite build",
    "get-browser": "node harness/get-browser.mjs"
  },
  "dependencies": {
    "@noble/ed25519": "2.3.0",
    "@noble/hashes": "1.6.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native-web": "0.21.2"
  },
  "devDependencies": {
    "@dfinity/agent": "^3.4.3",
    "@dfinity/candid": "^3.4.3",
    "@dfinity/cbor": "^0.2.3",
    "@dfinity/principal": "^3.4.3",
    "@puppeteer/browsers": "3.0.6",
    "@vitejs/plugin-react": "6.0.2",
    "pngjs": "^7.0.0",
    "puppeteer-core": "25.1.0",
    "sirv-cli": "3.0.1",
    "vite": "8.0.16"
  }
}
