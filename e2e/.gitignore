# e2e harness artifacts (build output, browser cache, screenshots)
node_modules/
dist/
.browser/
# Per-run captures are regenerable → ignored. The visual-regression BASELINES are the contract
# (committed PNGs the suite diffs against), so un-ignore the baselines/ subdir + its contents.
shots/*
!shots/baselines/
!shots/baselines/**
!shots/baselines-dark/
!shots/baselines-dark/**
