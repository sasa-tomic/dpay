# Rust
/target
**/target

# In-project toolchain + caches (persist locally, never commit)
/.dev
/third_party
/vendor

# Node / UI harness
node_modules
dist
# `e2e/shots/` is ignored by e2e/.gitignore (with an explicit baselines/ exception — the
# visual-regression baselines ARE committed as the diff contract). `app/shots/` is also regenerable.
/app/shots/
diff

# dfx local replica state + generated candid args (regenerated by scripts/dfx-deploy.sh)
.dfx
/dfx/args
# canister_ids.json is TRACKED: durable mainnet canister id map (see docs/CANISTERS.md).
# local-replica ids (.dfx/) stay ignored — they are ephemeral per-replica.

# Android: generated artifacts (regenerated by scripts/ndk-build-ffi.sh) + gradle/RN build outputs
**/src/main/jniLibs
**/src/main/java/uniffi
**/android/.gradle
**/android/**/build
/app/android/local.properties

# Android signing secrets. Public Play certificates live in app/android/app/play-signing/.
*.jks
*.keystore
*.p12
*.pfx
*.pk8
keystore.properties
signing.properties

# Secrets — deploy/.env carries the live Cloudflare API/tunnel token + canister id. Never commit any
# file literally named `.env` (this does not match .env.example or app/ios/.xcode.env).
.env

# misc
*.log
.DS_Store
dist-prod

# Agent fund leases (transient per-host claims, gitignored on purpose; the ledger stays tracked).
# The store lives in the MAIN checkout's funds/leases/ so every worktree sees one shared record —
# rationale in docs/AGENT-FUNDS.md.
/funds/leases/

# The trocador partner-agreement's append-only runtime files (DPAY_TROCADOR_LOG_DIR defaults
# to the process cwd, so local runs/e2e drop them in the tree they run from — relay runtime
# artifacts, never committed; the append-only retention lives on the deployed volume).
trocador-access.jsonl
trocador-orders.jsonl

# nested git worktrees (session work areas)
/.worktrees
