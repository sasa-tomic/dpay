{
  "name": "dpay-ui-harness",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Headless react-native-web harness for the dpay Pay/Receive screens. Renders the RN app in chromium (no Android emulator, no camera) and screenshots it for autonomous UI iteration.",
  "scripts": {
    "postinstall": "node scripts/get-browser.mjs",
    "build": "vite build",
    "shots": "node scripts/shoot.mjs",
    "compare": "node scripts/compare.mjs",
    "ui": "node scripts/ui.mjs"
  },
  "dependencies": {
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-native-web": "0.21.2"
  },
  "devDependencies": {
    "@puppeteer/browsers": "3.0.6",
    "@vitejs/plugin-react": "6.0.3",
    "pixelmatch": "7.2.0",
    "pngjs": "7.0.0",
    "puppeteer-core": "25.3.0",
    "sirv-cli": "3.0.0",
    "vite": "8.1.3"
  }
}
