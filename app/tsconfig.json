{
  "extends": "@react-native/typescript-config/tsconfig.json",
  "compilerOptions": {
    // MC8 U6.2: `wallet.ts`'s `resolveOnrampProvider()` lazy-loads the WalletConnect source via a
    // dynamic `import('./walletconnect')` (the isolation boundary — web/jest never statically pull
    // `@walletconnect/*`). Dynamic import syntax needs `module` >= es2020; the RN base config pins
    // `es2015`. Override to `esnext` (a safe superset for `--noEmit`: it only relaxes which import
    // syntax tsc accepts; Metro + Vite do their own transforming and do not read this field). Pairs
    // correctly with the base's `moduleResolution: "bundler"`.
    "module": "esnext"
  }
}
