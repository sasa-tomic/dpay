<resources>
    <!-- dpay identity ("Ballast": cold mist field + deep petrol teal accent). Mirrors
         app/config/palette.ts LIGHT — `accent` is that palette's `brand`, the FILL step, and
         `accent_ink` is its `brandInk`. A splash or a system accent left on a retired value
         while the app renders the current one is exactly the drift this file exists to prevent. -->
    <color name="bg">#EBF0ED</color>
    <color name="panel">#FAFCFB</color>
    <color name="ink">#17221F</color>
    <color name="accent">#0E5F53</color>
    <color name="accent_ink">#FFFFFF</color>
    <color name="white">#FFFFFF</color>
    <color name="black">#17221F</color>
</resources>
