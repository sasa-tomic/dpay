<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Night variant (uiMode=night) of the identity palette. Android switches automatically
         with the OS dark toggle; the RN app resolves the same scheme via Appearance and applies
         the matching in-app palette (app/config/palette.ts DARK). Values mirror palette.ts
         DARK: deep petrol-black family, NO pure #000. `white` stays #FFFFFF (it is the glyph
         ink in the launcher/splash, not a surface). `accent_ink` is DARK's `brandInk`: in the
         dark theme the lifted fill carries the deep petrol-black ink, ≈6.5:1 on brand. -->
    <color name="bg">#0C1312</color>
    <color name="panel">#121B19</color>
    <color name="ink">#ECF2EF</color>
    <color name="accent">#2FB497</color>
    <color name="accent_ink">#0C1312</color>
    <color name="white">#FFFFFF</color>
    <color name="black">#ECF2EF</color>
</resources>
