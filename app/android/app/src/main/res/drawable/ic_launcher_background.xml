<?xml version="1.0" encoding="utf-8"?>
<!-- Launcher background: the petrol tile, deepening downward. Full-bleed 108×108; the
     foreground carries the mist ∂. The two stops are LIGHT.brand → LIGHT.brand2 and MUST match
     app/components/Logo.tsx, which draws this same tile in-app from those two tokens - an
     emblem and an icon that disagree on the same home screen is the drift this comment exists
     to stop. The mist ∂ measures ≈6.5:1 on LIGHT.brand and ≈9:1 on LIGHT.brand2. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp" android:height="108dp"
    android:viewportWidth="108" android:viewportHeight="108">
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr xmlns:aapt="http://schemas.android.com/aapt" name="android:fillColor">
            <gradient android:type="linear" android:startX="54" android:startY="0" android:endX="54" android:endY="108">
                <item android:offset="0" android:color="#FF0E5F53"/>
                <item android:offset="1" android:color="#FF093F37"/>
            </gradient>
        </aapt:attr>
    </path>
</vector>
