<!-- Launcher background: the tangerine tile, deepening downward. Full-bleed 108×108; the
     foreground carries the porcelain ∂. The two stops are palette v5's LIGHT.brand → LIGHT.brand2
     and MUST match app/components/Logo.tsx, which draws this same tile in-app from those two
     tokens — an emblem and an icon that disagree on the same home screen is the drift this
     comment exists to stop. The retired top stop (#FF6A2B) left the porcelain ∂ at 3.0:1 across
     the top third of the tile; on these two it measures 4.66:1 and 8.71:1. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp" android:height="108dp"
    android:viewportWidth="108" android:viewportHeight="108">
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr xmlns:aapt="http://schemas.android.com/aapt" name="android:fillColor">
            <gradient android:type="linear" android:startX="54" android:startY="0" android:endX="54" android:endY="108">
                <item android:offset="0" android:color="#FFD03F00"/>
                <item android:offset="1" android:color="#FF912900"/>
            </gradient>
        </aapt:attr>
    </path>
</vector>
