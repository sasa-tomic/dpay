<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <!-- NFC: permission is needed to read the adapter state for the status chip (and, later, for the
         tap-to-pay HCE transport). `required=false` keeps the app installable on NFC-less phones,
         which fall back to QR. -->
    <uses-permission android:name="android.permission.NFC" />
    <uses-feature android:name="android.hardware.nfc" android:required="false" />

    <!-- WalletConnect wallet picker: Android 11+ package visibility, without which
         `Linking.canOpenURL` answers false for an INSTALLED wallet and the picker hides it. This
         block must list exactly the `KNOWN_WALLETS` rows in `app/wallet.ts` (which carries the
         source of the values and is where a new wallet is added); `__tests__/wallet-picker.test.ts`
         fails the build if the two ever disagree. Wallets not on that list still pair through the
         `wc:` system chooser, which needs no entry here. -->
    <queries>
        <package android:name="com.wallet.crypto.trustapp" />
        <package android:name="io.metamask" />
        <package android:name="me.rainbow" />
        <package android:name="io.zerion.android" />
        <package android:name="global.safe.mobileapp" />
        <package android:name="com.uniswap.mobile" />
    </queries>

    <application
      android:name=".MainApplication"
      android:label="@string/app_name"
      android:icon="@mipmap/ic_launcher"
      android:roundIcon="@mipmap/ic_launcher_round"
      android:allowBackup="false"
      android:theme="@style/AppTheme"
      android:usesCleartextTraffic="true"
      android:supportsRtl="true">
      <activity
        android:name=".MainActivity"
        android:label="@string/app_name"
        android:theme="@style/SplashTheme"
        android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
        android:launchMode="singleTask"
        android:windowSoftInputMode="adjustResize"
        android:exported="true">
        <intent-filter>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent-filter>
        <!-- Android App Link for a shared PAYMENT LINK
             (https://dpay.kalaj.org/wallet/pay/<recipient>?asset=…&amp;network=…&amp;amount=…).
             autoVerify makes Android fetch https://dpay.kalaj.org/.well-known/assetlinks.json
             (served by the relay) and check this build's signing certificate against it; when it
             matches, tapping the link in a messaging app opens THIS app instead of a browser tab.
             The same URL still works as a plain web link for anyone without the app installed —
             that is the point of using https rather than a private scheme. RN's Linking surfaces
             it via getInitialURL (launch) + the 'url' event (foreground); singleTask (set above)
             keeps the existing instance so the link reaches the live Wallet instead of stacking a
             second activity. Path-scoped to /wallet/pay/ so the app never claims the whole site
             (the landing page, /privacy and the plain /wallet stay in the browser). Wallet
             resolves the link and pre-fills the pay review — it NEVER auto-signs. -->
        <intent-filter android:autoVerify="true">
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.DEFAULT" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" android:host="dpay.kalaj.org" android:pathPrefix="/wallet/pay/" />
        </intent-filter>
        <!-- Android App Link for a CHECKOUT code (https://dpay.kalaj.org/pl/?lightning=<LNURL…>) — the
             QR a dpay checkout prints when the merchant opens a charge (`CHECKOUT_CODE_PATH` in
             crates/dpay-relay/src/checkout.rs mints it; the same assetlinks.json verification covers
             it, host-wide). Without this filter a phone WITH the app still opened the browser's
             static landing page when its camera read the checkout QR — the app could only pay a checkout
             through its own in-app scanner. With it, the camera opens the app straight into the
             OpenCryptoPay payer flow; every other camera still gets the /pl/ landing page, which
             is why the path stays https rather than a private scheme. Wallet routes the URL into
             the SAME classification a camera scan takes — explicit review, NEVER auto-sign. -->
        <intent-filter android:autoVerify="true">
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.DEFAULT" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" android:host="dpay.kalaj.org" android:pathPrefix="/pl/" />
        </intent-filter>
        <!-- dpay: scheme — the NFC-less receipt hand-back `dpay:pay/<blob>`: the payer shares the
             rail proof of a settled payment back to the merchant, whose Receive screen verifies it
             against on-chain history (never trusting the blob alone). This one stays a private
             scheme because it is machine state passed between two phones, not a human-facing link:
             nothing outside dpay can do anything with it. BROWSABLE lets a messaging app dispatch
             it. -->
        <intent-filter>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.DEFAULT" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="dpay" />
        </intent-filter>
      </activity>

      <!-- Payer-side HCE card. BIND_NFC_SERVICE ensures only the OS NFC stack can bind it; the AID
           group (res/xml/apduservice.xml) is category "other" → no Google Wallet clash. -->
      <service
        android:name=".DpayHostApduService"
        android:exported="true"
        android:permission="android.permission.BIND_NFC_SERVICE">
        <intent-filter>
            <action android:name="android.nfc.cardemulation.action.HOST_APDU_SERVICE" />
        </intent-filter>
        <meta-data
            android:name="android.nfc.cardemulation.host_apdu_service"
            android:resource="@xml/apduservice" />
      </service>

      <!-- SOL payer-side HCE card — a SECOND transport (pure Kotlin, no Rust core) on its own AID
           (F0 64 70 61 79 02 = "dpay" + v2/SOL), distinct from the IC AID so both coexist. -->
      <service
        android:name=".DpaySolHostApduService"
        android:exported="true"
        android:permission="android.permission.BIND_NFC_SERVICE">
        <intent-filter>
            <action android:name="android.nfc.cardemulation.action.HOST_APDU_SERVICE" />
        </intent-filter>
        <meta-data
            android:name="android.nfc.cardemulation.host_apdu_service"
            android:resource="@xml/solapduservice" />
      </service>
    </application>
</manifest>
